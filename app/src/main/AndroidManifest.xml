<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="@string/module_name"
        android:icon="@mipmap/ic_launcher"
        android:description="@string/module_description"
        android:supportsRtl="true">

        <!-- 设置页只有独立 Activity 这一条入口；不注入 Discord 设置界面或 JS bundle。 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/module_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 注意：io.github.libxposed.service.XposedProvider 由
             io.github.libxposed:service 这个 AAR 自带的 manifest 声明并合并进来，
             此处不要重复声明，否则会因 authority 重复而构建失败。 -->

    </application>
</manifest>
